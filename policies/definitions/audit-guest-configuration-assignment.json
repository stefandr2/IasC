{
  "name": "audit-guest-configuration-assignment",
  "type": "Microsoft.Authorization/policyDefinitions",
  "properties": {
    "displayName": "Audit machines missing Guest Configuration assignment",
    "policyType": "Custom",
    "mode": "All",
    "description": "Audits machines where Guest Configuration is not configured according to baseline requirements.",
    "metadata": {
      "category": "Guest Configuration"
    },
    "parameters": {},
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.Compute/virtualMachines",
          "Microsoft.HybridCompute/machines"
        ]
      },
      "then": {
        "effect": "audit"
      }
    }
  }
}
